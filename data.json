[
  {
    "id": "ap-chem-polyatomic",
    "title": "AP Chemistry: Polyatomic Ions",
    "description": "Formulas, charges, and systematic nomenclature for essential AP Chemistry polyatomic ions.",
    "icon": "⚗️",
    "category": "Chemistry",
    "cards": [
      { "id": "ion-1", "question": "C₂O₄²⁻", "answer": "Oxalate", "aliases": ["oxalate", "oxalate ion"], "explanation": "Oxalate (C₂O₄²⁻) is the dianion derived from oxalic acid (H₂C₂O₄) by loss of two protons." },
      { "id": "ion-2", "question": "NH₄⁺", "answer": "Ammonium", "aliases": ["ammonium", "ammonium ion"], "explanation": "Ammonium (NH₄⁺) is the positively charged cation formed by protonation of ammonia (NH₃)." },
      { "id": "ion-3", "question": "NO₃⁻", "answer": "Nitrate", "aliases": ["nitrate", "nitrate ion"], "explanation": "Nitrate (NO₃⁻) has trigonal planar geometry. All nitrate salts are highly soluble in water." },
      { "id": "ion-4", "question": "NO₂⁻", "answer": "Nitrite", "aliases": ["nitrite", "nitrite ion"], "explanation": "Nitrite (NO₂⁻) is the conjugate base of nitrous acid (HNO₂). It has a bent geometry due to the nitrogen lone pair." },
      { "id": "ion-5", "question": "SO₄²⁻", "answer": "Sulfate", "aliases": ["sulfate", "sulfate ion"], "explanation": "Sulfate (SO₄²⁻) has tetrahedral geometry with sulfur in the +6 oxidation state. Precipitates with Ba²⁺, Pb²⁺, and Ca²⁺." },
      { "id": "ion-6", "question": "SO₃²⁻", "answer": "Sulfite", "aliases": ["sulfite", "sulfite ion"], "explanation": "Sulfite (SO₃²⁻) has sulfur in the +4 oxidation state and a trigonal pyramidal geometry." },
      { "id": "ion-7", "question": "HSO₄⁻", "answer": "Hydrogen Sulfate", "aliases": ["hydrogen sulfate", "bisulfate", "bisulfate ion", "hydrogen sulfate ion"], "explanation": "Hydrogen sulfate (HSO₄⁻), also called bisulfate, is amphiprotic with a pKa of ~1.99." },
      { "id": "ion-8", "question": "OH⁻", "answer": "Hydroxide", "aliases": ["hydroxide", "hydroxide ion"], "explanation": "Hydroxide (OH⁻) is the Arrhenius base anion whose concentration defines the pOH and pH of a solution." },
      { "id": "ion-9", "question": "CN⁻", "answer": "Cyanide", "aliases": ["cyanide", "cyanide ion"], "explanation": "Cyanide (CN⁻) has a carbon-nitrogen triple bond. It is isoelectronic with CO and a strong-field ligand." },
      { "id": "ion-10", "question": "CO₃²⁻", "answer": "Carbonate", "aliases": ["carbonate", "carbonate ion"], "explanation": "Carbonate (CO₃²⁻) has trigonal planar geometry and reacts with strong acids to release CO₂ gas." },
      { "id": "ion-11", "question": "HCO₃⁻", "answer": "Hydrogen Carbonate", "aliases": ["hydrogen carbonate", "bicarbonate", "bicarbonate ion", "hydrogen carbonate ion"], "explanation": "Hydrogen carbonate (HCO₃⁻) is the primary physiological pH buffer in human blood plasma." },
      { "id": "ion-12", "question": "PO₄³⁻", "answer": "Phosphate", "aliases": ["phosphate", "phosphate ion", "orthophosphate"], "explanation": "Phosphate (PO₄³⁻) has tetrahedral geometry and forms the backbone of DNA, RNA, and ATP." },
      { "id": "ion-13", "question": "HPO₄²⁻", "answer": "Hydrogen Phosphate", "aliases": ["hydrogen phosphate", "hydrogen phosphate ion"], "explanation": "Hydrogen phosphate (HPO₄²⁻) is the mono-protonated phosphate and an intracellular buffer." },
      { "id": "ion-14", "question": "H₂PO₄⁻", "answer": "Dihydrogen Phosphate", "aliases": ["dihydrogen phosphate", "dihydrogen phosphate ion"], "explanation": "Dihydrogen phosphate (H₂PO₄⁻) is amphiprotic—it can donate or accept a proton." },
      { "id": "ion-15", "question": "ClO₄⁻", "answer": "Perchlorate", "aliases": ["perchlorate", "perchlorate ion"], "explanation": "Perchlorate (ClO₄⁻) has Cl in the +7 state and is a very weak conjugate base of the strong acid HClO₄." },
      { "id": "ion-16", "question": "ClO₃⁻", "answer": "Chlorate", "aliases": ["chlorate", "chlorate ion"], "explanation": "Chlorate (ClO₃⁻) has a trigonal pyramidal shape with chlorine in the +5 oxidation state." },
      { "id": "ion-17", "question": "ClO₂⁻", "answer": "Chlorite", "aliases": ["chlorite", "chlorite ion"], "explanation": "Chlorite (ClO₂⁻) features chlorine in the +3 state with a bent molecular geometry." },
      { "id": "ion-18", "question": "ClO⁻", "answer": "Hypochlorite", "aliases": ["hypochlorite", "hypochlorite ion"], "explanation": "Hypochlorite (ClO⁻) has Cl in the +1 state and is the active oxidizer in household bleach (NaClO)." },
      { "id": "ion-19", "question": "MnO₄⁻", "answer": "Permanganate", "aliases": ["permanganate", "permanganate ion"], "explanation": "Permanganate (MnO₄⁻) has Mn in the +7 state. Its deep purple color is a classic redox indicator in titrations." },
      { "id": "ion-20", "question": "CrO₄²⁻", "answer": "Chromate", "aliases": ["chromate", "chromate ion"], "explanation": "Chromate (CrO₄²⁻) has Cr in the +6 state and is bright yellow in basic conditions." },
      { "id": "ion-21", "question": "Cr₂O₇²⁻", "answer": "Dichromate", "aliases": ["dichromate", "dichromate ion"], "explanation": "Dichromate (Cr₂O₇²⁻) is orange in acidic solutions and in equilibrium with chromate (CrO₄²⁻) via pH." },
      { "id": "ion-22", "question": "C₂H₃O₂⁻", "answer": "Acetate", "aliases": ["acetate", "acetate ion", "ethanoate"], "explanation": "Acetate (CH₃COO⁻) is the conjugate base of acetic acid. All metal acetate salts are soluble in water." },
      { "id": "ion-23", "question": "SCN⁻", "answer": "Thiocyanate", "aliases": ["thiocyanate", "thiocyanate ion"], "explanation": "Thiocyanate (SCN⁻) forms a blood-red complex with Fe³⁺, used as a qualitative test for iron(III)." },
      { "id": "ion-24", "question": "O₂²⁻", "answer": "Peroxide", "aliases": ["peroxide", "peroxide ion"], "explanation": "Peroxide (O₂²⁻) has an O–O single bond with each oxygen in the −1 oxidation state." },
      { "id": "ion-25", "question": "IO₃⁻", "answer": "Iodate", "aliases": ["iodate", "iodate ion"], "explanation": "Iodate (IO₃⁻) is the conjugate base of iodic acid with iodine in the +5 state." },
      { "id": "ion-26", "question": "BrO₃⁻", "answer": "Bromate", "aliases": ["bromate", "bromate ion"], "explanation": "Bromate (BrO₃⁻) has bromine in the +5 state with a trigonal pyramidal structure." },
      { "id": "ion-27", "question": "S₂O₃²⁻", "answer": "Thiosulfate", "aliases": ["thiosulfate", "thiosulfate ion"], "explanation": "Thiosulfate (S₂O₃²⁻) replaces one oxygen of sulfate with S. It is the standard titrant in iodometry." },
      { "id": "ion-28", "question": "OCN⁻", "answer": "Cyanate", "aliases": ["cyanate", "cyanate ion"], "explanation": "Cyanate (OCN⁻) is a linear anion. Wöhler's synthesis of urea from ammonium cyanate in 1828 launched organic chemistry." }
    ]
  },
  {
    "id": "ap-chem-acids-bases",
    "title": "AP Chemistry: Strong Acids & Bases",
    "description": "The 7 strong acids and strong soluble metal hydroxide bases required for AP Chemistry.",
    "icon": "🧪",
    "category": "Chemistry",
    "cards": [
      { "id": "ab-1", "question": "HCl", "answer": "Hydrochloric Acid", "aliases": ["hydrochloric acid", "hydrochloric"], "explanation": "HCl is a strong monoprotic binary acid that fully dissociates: HCl → H⁺ + Cl⁻." },
      { "id": "ab-2", "question": "HNO₃", "answer": "Nitric Acid", "aliases": ["nitric acid", "nitric"], "explanation": "HNO₃ is a strong oxyacid and powerful oxidizing agent that fully ionizes to H⁺ + NO₃⁻." },
      { "id": "ab-3", "question": "H₂SO₄", "answer": "Sulfuric Acid", "aliases": ["sulfuric acid", "sulfuric"], "explanation": "H₂SO₄ is a strong diprotic acid; its first dissociation is 100% complete, while HSO₄⁻ is weak (Ka ≈ 1.2×10⁻²)." },
      { "id": "ab-4", "question": "HBr", "answer": "Hydrobromic Acid", "aliases": ["hydrobromic acid", "hydrobromic"], "explanation": "HBr is a strong binary haloacid due to the long, weak H–Br bond." },
      { "id": "ab-5", "question": "HI", "answer": "Hydroiodic Acid", "aliases": ["hydroiodic acid", "hydroiodic"], "explanation": "HI is the strongest common binary haloacid because iodide holds the proton very loosely." },
      { "id": "ab-6", "question": "HClO₄", "answer": "Perchloric Acid", "aliases": ["perchloric acid", "perchloric"], "explanation": "HClO₄ has four electronegative oxygens pulling density from the O–H bond, making it extremely strong." },
      { "id": "ab-7", "question": "HClO₃", "answer": "Chloric Acid", "aliases": ["chloric acid", "chloric"], "explanation": "HClO₃ is recognized on the AP Chemistry exam as one of the 7 strong acids." },
      { "id": "ab-8", "question": "Ba(OH)₂", "answer": "Barium Hydroxide", "aliases": ["barium hydroxide"], "explanation": "Barium hydroxide is a strong, soluble Group 2 base that yields 2 mol OH⁻ per mole dissolved." }
    ]
  },
